<Window x:Class="ComPortUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Serial &amp; Build Tool" Height="500" Width="850" FontSize="18" Closing="Window_Closing">
    <Grid>
        <TabControl>
            <TabItem Header="Serial Terminal">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="10">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button x:Name="LoadFileButton" Content="Load File" Click="LoadFileButton_Click" Margin="0,0,10,0"/>
                            <CheckBox x:Name="ConvertStringToBin" Content="String to Bin" VerticalAlignment="Center"  VerticalContentAlignment="Center"/>
                        </StackPanel>
                        <Label Content="Input" />
                        <TextBox x:Name="Input_TB" Height="300" TextWrapping="Wrap" KeyDown="Input_TB_KeyDown"  FontFamily="Consolas" VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="10">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <ComboBox x:Name="OutputFormat_CB" Width="120"  SelectionChanged="OutputFormat_CB_SelectionChanged" Margin="0,0,10,0">
                                <ComboBoxItem IsSelected="True">ASCII</ComboBoxItem>
                                <ComboBoxItem>Hex</ComboBoxItem>
                            </ComboBox>
                            <Button x:Name="ClearOutput_Btn" Content="Clear" Width="70"  Click="ClearOutput_Btn_Click"/>
                        </StackPanel>
                        <Label Content="Output" />
                        <TextBox x:Name="Output_TB" Height="300" TextWrapping="Wrap" IsReadOnly="True"  FontFamily="Consolas" VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="GCC Compiler">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button x:Name="SelectSourceBtn" Content="Select Source File" Click="SelectSourceBtn_Click" Padding="10,5"/>
                        <Button x:Name="RunBatBtn" Content="Run GCC Build" Click="RunBatBtn_Click" Padding="20,5" Margin="15,0" Background="LightGreen"/>
                        <TextBlock x:Name="SelectedFilePath" Text="No file selected" VerticalAlignment="Center" Foreground="Gray"/>
                    </StackPanel>

                    <GroupBox Header="Console Output" Grid.Row="1">
                        <TextBox x:Name="ConsoleOutput_TB" Background="Black" Foreground="White" FontFamily="Consolas" IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="Settings">
                <StackPanel Margin="20" MaxWidth="600" HorizontalAlignment="Left">
                    <Label Content="GCC Build Folder" FontWeight="Bold"/>
                    <DockPanel Margin="0,5,0,20">
                        <Button x:Name="BrowseBatBtn" Content="Browse" DockPanel.Dock="Right" Click="BrowseBatBtn_Click" Width="75" Margin="5,0,0,0"/>
                        <TextBox x:Name="BatPath_TB" Text="" VerticalContentAlignment="Center" HorizontalAlignment="Left" Width="500" TextChanged="BatPath_TB_TextChanged"/>
                    </DockPanel>

                    <Label Content="Linker Path" FontWeight="Bold"/>
                    <DockPanel Margin="0,5,0,20">
                        <Button x:Name="BrowseLdBtn" Content="Browse" DockPanel.Dock="Right" Click="BrowseLdBtn_Click" Width="75" Margin="5,0,0,0"/>
                        <TextBox x:Name="LdPath_TB" Text="" VerticalContentAlignment="Center" HorizontalAlignment="Left" Width="500" TextChanged="LdPath_TB_TextChanged"/>
                    </DockPanel>

                    <Label Content="Libs Path" FontWeight="Bold"/>
                    <DockPanel Margin="0,5,0,20">
                        <Button x:Name="BrowseLibBtn" Content="Browse" DockPanel.Dock="Right" Click="BrowseLibBtn_Click" Width="75" Margin="5,0,0,0"/>
                        <TextBox x:Name="LibPath_TB" Text="" VerticalContentAlignment="Center" HorizontalAlignment="Left" Width="500" TextChanged="LibPath_TB_TextChanged"/>
                    </DockPanel>

                    <Label Content="GCC Path" FontWeight="Bold"/>
                    <DockPanel Margin="0,5,0,20">
                        <Button x:Name="BrowseGccBtn" Content="Browse" DockPanel.Dock="Right" Width="75" Margin="5,0,0,0" Click="BrowseGccBtn_Click"/>
                        <TextBox x:Name="GccPath_TB" Text="" VerticalContentAlignment="Center" HorizontalAlignment="Left" Width="500" TextChanged="GccPath_TB_TextChanged" />
                    </DockPanel>

                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>