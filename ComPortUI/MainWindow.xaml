<Window x:Class="ComPortUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Serial &amp; Build Tool" 
        Height="550" Width="850" 
        MinHeight="400" MinWidth="650"
        FontSize="18" 
        Closing="Window_Closing">
    <Grid>
        <TabControl>
            <!-- ================= SERIAL TERMINAL ================= -->
            <TabItem Header="Serial Terminal">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <!-- Splitter column allows manual dragging between Input and Output -->
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Column: Input -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                            <Button x:Name="LoadFileButton" Content="Load File" Click="LoadFileButton_Click" Margin="0,0,10,0" Padding="10,2"/>
                            <CheckBox x:Name="ConvertStringToBin" Content="String to Bin" VerticalAlignment="Center" VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <Label Grid.Row="1" Content="Input" Padding="0,0,0,5"/>

                        <!-- Removed Height="300" so it stretches to fill the row -->
                        <TextBox x:Name="Input_TB" Grid.Row="2" TextWrapping="Wrap" KeyDown="Input_TB_KeyDown" FontFamily="Consolas" VerticalScrollBarVisibility="Auto"/>
                    </Grid>

                    <!-- Draggable GridSplitter -->
                    <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="#FFE0E0E0"/>

                    <!-- Right Column: Output -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                            <ComboBox x:Name="OutputFormat_CB" MinWidth="110" SelectionChanged="OutputFormat_CB_SelectionChanged" Margin="0,0,10,0">
                                <ComboBoxItem IsSelected="True">ASCII</ComboBoxItem>
                                <ComboBoxItem>Hex</ComboBoxItem>
                            </ComboBox>
                            <Button x:Name="ClearOutput_Btn" Content="Clear" Padding="15,2" Click="ClearOutput_Btn_Click"/>
                        </StackPanel>

                        <Label Grid.Row="1" Content="Output" Padding="0,0,0,5"/>

                        <!-- Removed Height="300" so it stretches to fill the row -->
                        <TextBox x:Name="Output_TB" Grid.Row="2" TextWrapping="Wrap" IsReadOnly="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto"/>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ================= GCC COMPILER ================= -->
            <TabItem Header="GCC Compiler">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Using DockPanel so SelectedFilePath trims cleanly if the window is made narrow -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <Button x:Name="SelectSourceBtn" DockPanel.Dock="Left" Content="Select Source File" Click="SelectSourceBtn_Click" Padding="10,5"/>
                        <Button x:Name="RunBatBtn" DockPanel.Dock="Left" Content="Run GCC Build" Click="RunBatBtn_Click" Padding="20,5" Margin="15,0" Background="LightGreen"/>
                        <TextBlock x:Name="SelectedFilePath" Text="No file selected" VerticalAlignment="Center" Foreground="Gray" TextTrimming="CharacterEllipsis" Margin="10,0,0,0"/>
                    </DockPanel>

                    <GroupBox Header="Console Output" Grid.Row="1">
                        <TextBox x:Name="ConsoleOutput_TB" Background="Black" Foreground="White" FontFamily="Consolas" IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- ================= SETTINGS ================= -->
            <TabItem Header="Settings">
                <!-- ScrollViewer ensures nothing gets cut off if window height is small -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20" MaxWidth="800">
                        <Label Content="GCC Build Folder" FontWeight="Bold"/>
                        <DockPanel Margin="0,5,0,20">
                            <Button x:Name="BrowseBatBtn" Content="Browse" DockPanel.Dock="Right" Click="BrowseBatBtn_Click" Padding="12,4" Margin="10,0,0,0"/>
                            <!-- Removed Width="500" and HorizontalAlignment="Left" so it fills the row -->
                            <TextBox x:Name="BatPath_TB" Text="" VerticalContentAlignment="Center" TextChanged="BatPath_TB_TextChanged"/>
                        </DockPanel>

                        <Label Content="Linker Path" FontWeight="Bold"/>
                        <DockPanel Margin="0,5,0,20">
                            <Button x:Name="BrowseLdBtn" Content="Browse" DockPanel.Dock="Right" Click="BrowseLdBtn_Click" Padding="12,4" Margin="10,0,0,0"/>
                            <TextBox x:Name="LdPath_TB" Text="" VerticalContentAlignment="Center" TextChanged="LdPath_TB_TextChanged"/>
                        </DockPanel>

                        <Label Content="Libs Path" FontWeight="Bold"/>
                        <DockPanel Margin="0,5,0,20">
                            <Button x:Name="BrowseLibBtn" Content="Browse" DockPanel.Dock="Right" Click="BrowseLibBtn_Click" Padding="12,4" Margin="10,0,0,0"/>
                            <TextBox x:Name="LibPath_TB" Text="" VerticalContentAlignment="Center" TextChanged="LibPath_TB_TextChanged"/>
                        </DockPanel>

                        <Label Content="GCC Path" FontWeight="Bold"/>
                        <DockPanel Margin="0,5,0,20">
                            <Button x:Name="BrowseGccBtn" Content="Browse" DockPanel.Dock="Right" Padding="12,4" Margin="10,0,0,0" Click="BrowseGccBtn_Click"/>
                            <TextBox x:Name="GccPath_TB" Text="" VerticalContentAlignment="Center" TextChanged="GccPath_TB_TextChanged" />
                        </DockPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>